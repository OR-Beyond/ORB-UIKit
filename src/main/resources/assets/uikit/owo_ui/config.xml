<?xml version="1.0" encoding="UTF-8"?>
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal">
            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
            <children>
                <flow-layout direction="vertical" id="panel">
                    <sizing>
                        <horizontal method="content"/>
                        <vertical method="fill">100</vertical>
                    </sizing>
                    <surface>
                        <flat color="0xFF121212"/>
                        <outline color="0xFF333333"/>
                    </surface>
                    <children>
                        <flow-layout direction="horizontal" id="body">
                            <sizing>
                                <horizontal method="content"/>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <children>
                                <flow-layout direction="vertical" id="rail">
                                    <sizing>
                                        <horizontal method="fixed">48</horizontal>
                                        <vertical method="fill">100</vertical>
                                    </sizing>
                                    <surface>
                                        <flat color="0xFF0E0E0E"/>
                                        <outline color="0xFF333333"/>
                                    </surface>
                                    <horizontal-alignment method="center"/>
                                    <vertical-alignment method="top"/>
                                    <gap>2</gap>
                                    <padding>
                                        <top>6</top>
                                        <bottom>6</bottom>
                                    </padding>
                                    <children>
                                        <box id="rail-marker">
                                            <positioning type="absolute">
                                                <x>0</x>
                                                <y>0</y>
                                            </positioning>
                                            <sizing>
                                                <horizontal method="fixed">2</horizontal>
                                                <vertical method="fixed">40</vertical>
                                            </sizing>
                                            <color>0xFFFFFFFF</color>
                                        </box>
                                    </children>
                                </flow-layout>
                                <flow-layout direction="vertical" id="drawer">
                                    <sizing>
                                        <horizontal method="fixed">248</horizontal>
                                        <vertical method="fill">100</vertical>
                                    </sizing>
                                    <surface>
                                        <flat color="0xFF161616"/>
                                    </surface>
                                    <children>
                                        <flow-layout direction="horizontal" id="drawer-header">
                                            <sizing>
                                                <horizontal method="fill">100</horizontal>
                                                <vertical method="fixed">26</vertical>
                                            </sizing>
                                            <surface>
                                                <flat color="0xFF1A1A1A"/>
                                                <outline color="0xFF333333"/>
                                            </surface>
                                            <vertical-alignment method="center"/>
                                            <gap>6</gap>
                                            <padding>
                                                <all>6</all>
                                            </padding>
                                            <children>
                                                <label id="drawer-title">
                                                    <text>ORB-UIKit</text>
                                                    <horizontal-alignment method="left"/>
                                                </label>
                                                <spacer>
                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                        <vertical method="fixed">1</vertical>
                                                    </sizing>
                                                </spacer>
                                            </children>
                                        </flow-layout>
                                        <scroll>
                                            <sizing>
                                                <horizontal method="fill">100</horizontal>
                                                <vertical method="expand">100</vertical>
                                            </sizing>
                                            <scrollbar-thiccness>3</scrollbar-thiccness>
                                            <padding>
                                                <right>3</right>
                                            </padding>
                                            <children>
                                                <flow-layout direction="vertical" id="drawer-content">
                                                    <sizing>
                                                        <horizontal method="fill">100</horizontal>
                                                        <vertical method="content"/>
                                                    </sizing>
                                                    <padding>
                                                        <all>6</all>
                                                    </padding>
                                                    <gap>3</gap>
                                                </flow-layout>
                                            </children>
                                        </scroll>
                                        <flow-layout direction="horizontal" id="drawer-footer">
                                            <sizing>
                                                <horizontal method="fill">100</horizontal>
                                                <vertical method="fixed">24</vertical>
                                            </sizing>
                                            <surface>
                                                <flat color="0xFF1A1A1A"/>
                                                <outline color="0xFF333333"/>
                                            </surface>
                                            <horizontal-alignment method="right"/>
                                            <vertical-alignment method="center"/>
                                            <gap>6</gap>
                                            <padding>
                                                <horizontal>6</horizontal>
                                            </padding>
                                            <children>
                                                <label id="dirty-hint">
                                                    <text>&#8203;</text>
                                                    <color>0xFFD479</color>
                                                    <horizontal-alignment method="left"/>
                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                        <vertical method="content"/>
                                                    </sizing>
                                                </label>
                                                <button id="btn-cancel">
                                                    <sizing>
                                                        <horizontal method="fixed">70</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </button>
                                                <button id="btn-save">
                                                    <sizing>
                                                        <horizontal method="fixed">70</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </button>
                                            </children>
                                        </flow-layout>
                                    </children>
                                </flow-layout>
                            </children>
                        </flow-layout>
                    </children>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
</owo-ui>